# 本地示例 API：web/server/recommend-api.mjs
# Windows PowerShell：$env:MIMO_API_KEY="你的key"; node server/recommend-api.mjs
MIMO_API_KEY=
MIMO_API_SERVER_PORT=8788
# Vite 开发端口（默认 5173）；若占用请关掉占用进程或改此处，避免静默换端口
# VITE_DEV_PORT=5173
# Token Plan（中国区 OpenAI 兼容），与控制台「专属基本 URL」一致
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 可选：控制台展示的模型名若为 slug，默认即为下列值
# MIMO_MODEL=mimo-v2.5-pro

# ---------- 生产部署（Vercel 前端 → Railway API）----------
# Vercel Build 环境变量：Railway 给的根 URL，无尾斜杠
# VITE_API_BASE_URL=https://your-service.up.railway.app
#
# Railway Variables：
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
# （留空则 CORS 为 *，仅建议本地；生产务必填 Vercel 域名）
# LISTEN_HOST=0.0.0.0   # 可选；有 PORT 时已默认 0.0.0.0
